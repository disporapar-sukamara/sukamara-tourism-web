---
import '../styles/globals.css';
import TopBar from '../components/layout/TopBar.astro';
import Navbar from '../components/layout/Navbar.astro';
import Footer from '../components/layout/Footer.astro';
import SearchModal from '../components/ui/SearchModal.astro';
import DestinationModal from '../components/ui/DestinationModal.astro';
import EventModal from '../components/ui/EventModal.astro';
import NewsModal from '../components/ui/NewsModal.astro';
import GalleryLightbox from '../components/ui/GalleryLightbox.astro';
import YouthSportsModal from '../components/ui/YouthSportsModal.astro';

interface Props {
  title?: string;
  description?: string;
}

const { 
  title = "Smart Tourism Sukamara — Portal Resmi Pariwisata Kab. Sukamara",
  description = "Portal resmi Smart Tourism Kabupaten Sukamara. Strategi integrasi pemasaran destinasi wisata, peta digital, agenda event, kepemudaan, dan olahraga."
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? 'https://disporapar.sukamarakab.go.id');
const ogImageUrl = new URL('/images/destinasi/pantai-citra.webp', Astro.site ?? 'https://disporapar.sukamarakab.go.id');
---

<!doctype html>
<html lang="id" class="scroll-smooth scroll-pt-20">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/images/branding/logo-kabupaten-sukamara.png" />
    <meta name="generator" content={Astro.generator} />
    
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph / Meta -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />

    <!-- Preload Primary Font for zero-FOIT First Paint -->
    <link rel="preload" href="/fonts/plus-jakarta-sans-latin.woff2" as="font" type="font/woff2" crossorigin />

    <!-- Responsive Preload Hero LCP Image -->
    <link rel="preload" as="image" href="/images/destinasi/carousel/0/gambar-mobile.webp" type="image/webp" media="(max-width: 768px)" fetchpriority="high" />
    <link rel="preload" as="image" href="/images/destinasi/carousel/0/gambar.webp" type="image/webp" media="(min-width: 769px)" fetchpriority="high" />
  </head>
  <body class="min-h-screen flex flex-col bg-white text-gray-700 antialiased selection:bg-brand-blue selection:text-white">
    <TopBar />
    <Navbar />
    
    <main class="flex-1">
      <slot />
    </main>

    <Footer />
    <SearchModal />
    <DestinationModal />
    <EventModal />
    <NewsModal />
    <GalleryLightbox />
    <YouthSportsModal />
  </body>
</html>
