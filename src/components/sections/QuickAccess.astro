---
import { Palmtree, MapPin, Calendar, Trophy, Newspaper, Camera } from 'lucide-astro';

const items = [
  {
    title: 'Destinasi Wisata',
    desc: 'Pesona alam terbaik',
    icon: Palmtree,
    color: 'text-emerald-300',
    bgColor: 'bg-emerald-500/20 border-emerald-400/30',
    href: '#destinasi-unggulan'
  },
  {
    title: 'Peta Digital',
    desc: 'Lokasi & rute peta',
    icon: MapPin,
    color: 'text-teal-300',
    bgColor: 'bg-teal-500/20 border-teal-400/30',
    href: '#peta-wisata'
  },
  {
    title: 'Kalender Event',
    desc: 'Agenda budaya',
    icon: Calendar,
    color: 'text-pink-300',
    bgColor: 'bg-pink-500/20 border-pink-400/30',
    href: '#agenda-mendatang'
  },
  {
    title: 'Pemuda & Olahraga',
    desc: 'Prestasi & fasilitas',
    icon: Trophy,
    color: 'text-amber-300',
    bgColor: 'bg-amber-500/20 border-amber-400/30',
    href: '#kepemudaan-olahraga'
  },
  {
    title: 'Berita & Info',
    desc: 'Publikasi terkini',
    icon: Newspaper,
    color: 'text-sky-300',
    bgColor: 'bg-sky-500/20 border-sky-400/30',
    href: '#berita-terbaru'
  },
  {
    title: 'Galeri Wisata',
    desc: 'Foto & video pilihan',
    icon: Camera,
    color: 'text-indigo-300',
    bgColor: 'bg-indigo-500/20 border-indigo-400/30',
    href: '#galeri'
  }
];
---

<div class="w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-2 pb-1">
  <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-2 sm:gap-2.5">
    {items.map((item) => {
      const Icon = item.icon;
      return (
        <a 
          href={item.href}
          class="bg-white/10 hover:bg-white/20 backdrop-blur-md border border-white/20 rounded-xl p-2 sm:p-2.5 flex items-center gap-2 transition-all duration-200 hover:-translate-y-0.5 group text-white cursor-pointer shadow-sm"
        >
          <div class={`w-7 h-7 sm:w-8 sm:h-8 rounded-lg ${item.bgColor} border flex items-center justify-center shrink-0`}>
            <Icon class={`w-3.5 h-3.5 sm:w-4 sm:h-4 ${item.color}`} />
          </div>
          <div class="min-w-0 flex-1 text-left">
            <h4 class="font-bold text-white text-[11px] sm:text-xs leading-tight truncate group-hover:text-sky-300 transition-colors">
              {item.title}
            </h4>
            <p class="text-[9px] sm:text-[10px] text-white/70 leading-tight truncate">
              {item.desc}
            </p>
          </div>
        </a>
      );
    })}
  </div>
</div>