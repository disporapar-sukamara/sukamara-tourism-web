---
import { getCollection } from 'astro:content';
import { MapPin, Compass } from 'lucide-astro';

const destinasiList = await getCollection('destinasi');

// Filter only destinations with coordinates
const mapDestinations = destinasiList
  .filter((item) => item.data.latitude && item.data.longitude)
  .map((item) => ({
    id: item.id,
    nama: item.data.nama,
    kategori: item.data.kategori,
    kecamatan: item.data.kecamatan,
    alamat: item.data.alamat || item.data.kecamatan,
    gambar: item.data.gambar,
    tiket: item.data.tiket || 'Gratis',
    lat: Number(item.data.latitude),
    lng: Number(item.data.longitude),
  }));
---

<section id="peta-wisata" class="w-full min-h-[calc(100vh-5rem)] flex flex-col justify-center py-8 lg:py-10 bg-[#F8FAFC]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full my-auto">
    
    <!-- Section Header -->
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-8 gap-4">
      <div>
        <div class="flex items-center gap-2 mb-1">
          <div class="w-8 h-8 rounded-lg bg-teal-100 flex items-center justify-center text-[#0E9F8E]">
            <Compass class="w-5 h-5" />
          </div>
          <h2 class="text-2xl sm:text-3xl font-extrabold text-[#0B2A5B] tracking-tight">
            Peta Digital Destinasi Sukamara
          </h2>
        </div>
        <p class="text-xs sm:text-sm text-gray-500 max-w-xl">
          Eksplorasi sebaran objek wisata bahari, alam, religi, dan budaya di seluruh wilayah Kabupaten Sukamara secara interaktif.
        </p>
      </div>
      
      <!-- Legend / Badge -->
      <div class="flex flex-wrap items-center gap-2 text-xs font-semibold">
        <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-blue-50 text-blue-700 border border-blue-200">
          <span class="w-2 h-2 rounded-full bg-blue-600"></span> Wisata Bahari
        </span>
        <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-teal-50 text-teal-700 border border-teal-200">
          <span class="w-2 h-2 rounded-full bg-teal-600"></span> Wisata Alam
        </span>
        <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-amber-50 text-amber-700 border border-amber-200">
          <span class="w-2 h-2 rounded-full bg-amber-600"></span> Wisata Religi & Budaya
        </span>
      </div>
    </div>

    <!-- Map Container Card -->
    <div class="relative bg-white rounded-2xl shadow-lg border border-gray-100 overflow-hidden">
      <!-- Leaflet Map Canvas -->
      <div id="sukamara-map" class="w-full h-[400px] sm:h-[460px] lg:h-[500px] z-10"></div>

      <!-- Bottom Bar with Quick Destinations -->
      <div class="p-4 bg-white border-t border-gray-100 flex flex-wrap items-center justify-between gap-3 text-xs text-gray-600">
        <div class="flex items-center gap-2">
          <MapPin class="w-4 h-4 text-[#D6197A]" />
          <span>Menampilkan <strong>{mapDestinations.length}</strong> titik destinasi wisata terverifikasi. Klik pin untuk info rute.</span>
        </div>
        <div class="text-gray-600">
          Didukung OpenStreetMap & Leaflet Digital Map
        </div>
      </div>
    </div>

  </div>
</section>

<!-- Pass data safely to client script & lazy load Leaflet on intersection -->
<script is:inline define:vars={{ mapDestinations }}>
  // ponytail: Lightweight lazy Leaflet initialization; upgrade to Mapbox when custom satellite 3D terrain is needed
  function setupMapLoader() {
    const mapElement = document.getElementById('sukamara-map');
    if (!mapElement) return;

    let loaded = false;
    function loadAndInit() {
      if (loaded) return;
      loaded = true;

      // Lazy load CSS
      if (!document.querySelector('link[href*="leaflet.css"]')) {
        const link = document.createElement('link');
        link.rel = 'stylesheet';
        link.href = 'https://unpkg.com/leaflet@1.9.4/dist/leaflet.css';
        link.integrity = 'sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=';
        link.crossOrigin = '';
        document.head.appendChild(link);
      }

      // Lazy load JS
      let retries = 0;
      function startMap() {
        if (typeof L === 'undefined') {
          if (retries++ < 25) {
            setTimeout(startMap, 150);
          }
          return;
        }
        if (mapElement._leaflet_id) return;

        // Center of Sukamara Regency (-2.85, 111.20)
        const map = L.map('sukamara-map', {
          center: [-2.85, 111.20],
          zoom: 9,
          scrollWheelZoom: false,
        });

        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
          maxZoom: 18,
          attribution: '&copy; OpenStreetMap contributors',
        }).addTo(map);

        const bounds = L.latLngBounds();

        mapDestinations.forEach((item) => {
          if (!item.lat || !item.lng) return;

          const marker = L.marker([item.lat, item.lng]).addTo(map);
          bounds.extend([item.lat, item.lng]);

          const gmapsUrl = `https://www.google.com/maps/dir/?api=1&destination=${item.lat},${item.lng}`;

          const popupContent = `
            <div style="font-family: inherit; min-width: 200px; max-width: 240px; padding: 2px;">
              <img src="${item.gambar}" alt="${item.nama}" width="240" height="110" loading="lazy" decoding="async" style="width: 100%; height: 110px; object-fit: cover; border-radius: 8px; margin-bottom: 8px;" />
              <span style="font-size: 10px; font-weight: 700; text-transform: uppercase; color: #1E5FD8; background: #E6F0FF; padding: 2px 6px; border-radius: 4px;">
                ${item.kategori}
              </span>
              <h3 style="margin: 6px 0 2px 0; font-size: 14px; font-weight: 800; color: #0B2A5B; line-height: 1.2;">
                ${item.nama}
              </h3>
              <p style="margin: 0 0 8px 0; font-size: 11px; color: #525D6D;">
                ${item.kecamatan} • Tiket: ${item.tiket}
              </p>
              <a href="${gmapsUrl}" target="_blank" rel="noopener noreferrer" style="display: block; background: #0F766E; color: white; text-decoration: none; padding: 8px 12px; border-radius: 6px; font-size: 11px; font-weight: 700; text-align: center;">
                📍 Buka Rute di Google Maps
              </a>
            </div>
          `;

          marker.bindPopup(popupContent);
        });

        if (mapDestinations.length > 0) {
          map.fitBounds(bounds, { padding: [40, 40], maxZoom: 11 });
        }
      }

      if (typeof L === 'undefined') {
        const script = document.createElement('script');
        script.src = 'https://unpkg.com/leaflet@1.9.4/dist/leaflet.js';
        script.crossOrigin = '';
        script.onload = startMap;
        script.onerror = () => {
          // ponytail: Graceful failure if Leaflet CDN unreachable in sandbox/crawler
        };
        document.body.appendChild(script);
      } else {
        startMap();
      }
    }

    if ('IntersectionObserver' in window) {
      const observer = new IntersectionObserver((entries) => {
        if (entries[0].isIntersecting) {
          observer.disconnect();
          loadAndInit();
        }
      }, { rootMargin: '100px' });
      observer.observe(mapElement);
    } else {
      loadAndInit();
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupMapLoader);
  } else {
    setupMapLoader();
  }
  document.addEventListener('astro:after-swap', setupMapLoader);
</script>