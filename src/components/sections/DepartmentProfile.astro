---
import { Landmark, FileText, Download, Users, CheckCircle2, Layers } from 'lucide-astro';
import { departmentData } from '../../data/departmentData';

const { dasarHukum, tugasPokok, fungsi, struktur } = departmentData;
---

<section id="profil-dinas" class="w-full py-12 lg:py-16 bg-slate-50 border-b border-gray-100 scroll-mt-20">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-8 sm:space-y-10">

    <!-- Section Header -->
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-4">
      <div>
        <div class="flex items-center gap-2 mb-2">
          <div class="w-8 h-8 rounded-lg bg-blue-100 text-[#1E5FD8] flex items-center justify-center">
            <Landmark class="w-5 h-5" />
          </div>
          <span class="text-xs font-bold uppercase tracking-wider text-[#1E5FD8]">Profil Resmi Instansi</span>
        </div>
        <h2 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-[#0B2A5B] tracking-tight">
          Profil Dinas Kepemudaan, Olahraga dan Pariwisata
        </h2>
        <p class="text-sm text-gray-600 mt-1 max-w-3xl">
          Pemerintah Kabupaten Sukamara — Tugas Pokok, Fungsi, dan Struktur Organisasi SOTK Disporapar.
        </p>
      </div>

      <!-- Quick Action: Unduh Perbup -->
      <a 
        href={dasarHukum.filePdf}
        download="Perbup-No-55-Tahun-2022-SOTK-DISPORAPAR.pdf"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-[#0B2A5B] hover:bg-blue-900 text-white text-xs sm:text-sm font-semibold transition-all shadow-sm hover:shadow shrink-0"
      >
        <Download class="w-4 h-4 text-sky-300" />
        <span>Unduh Perbup No. 55/2022 (PDF)</span>
      </a>
    </div>

    <!-- Banner Info Dasar Hukum -->
    <div class="bg-white border border-blue-100 rounded-2xl p-5 sm:p-6 shadow-xs flex flex-col md:flex-row items-start md:items-center justify-between gap-4">
      <div class="flex items-start gap-3 sm:gap-4">
        <div class="w-10 h-10 rounded-xl bg-blue-50 text-[#1E5FD8] flex items-center justify-center shrink-0 mt-0.5">
          <FileText class="w-5 h-5" />
        </div>
        <div>
          <span class="inline-block text-[11px] font-bold uppercase tracking-wider px-2.5 py-0.5 rounded-full bg-blue-100 text-[#1E5FD8] mb-1">
            Dasar Hukum & Tata Kerja
          </span>
          <h3 class="text-base sm:text-lg font-bold text-gray-900">
            {dasarHukum.nomor}
          </h3>
          <p class="text-xs sm:text-sm text-gray-600 mt-0.5">
            {dasarHukum.tentang}
          </p>
        </div>
      </div>
    </div>

    <!-- Segmented Tab Switcher -->
    <div class="flex border-b border-gray-200" role="tablist" aria-label="Tab Profil Dinas">
      <button 
        type="button" 
        id="tab-btn-struktur"
        role="tab"
        aria-selected="true"
        aria-controls="panel-struktur"
        class="tab-btn px-5 py-3 text-sm font-bold border-b-2 border-[#1E5FD8] text-[#1E5FD8] transition-colors flex items-center gap-2 cursor-pointer"
      >
        <Layers class="w-4 h-4" />
        <span>Bagan Struktur Organisasi</span>
      </button>

      <button 
        type="button" 
        id="tab-btn-tupoksi"
        role="tab"
        aria-selected="false"
        aria-controls="panel-tupoksi"
        class="tab-btn px-5 py-3 text-sm font-semibold border-b-2 border-transparent text-gray-500 hover:text-gray-800 transition-colors flex items-center gap-2 cursor-pointer"
      >
        <Users class="w-4 h-4" />
        <span>Tugas Pokok & 16 Fungsi</span>
      </button>
    </div>

    <!-- Tab Panels Container -->
    <div>
      <!-- PANEL 1: Struktur Organisasi (Bagan Visual Presisi Resmi SOTK) -->
      <div id="panel-struktur" role="tabpanel" aria-labelledby="tab-btn-struktur" class="space-y-6">
        
        <div class="bg-white rounded-2xl border border-gray-200 p-4 sm:p-6 lg:p-8 shadow-xs">
          
          <!-- Bagan Header & Legend -->
          <div class="flex flex-col sm:flex-row sm:items-center justify-between pb-4 mb-4 border-b border-gray-100 gap-3">
            <div>
              <span class="text-[10px] font-extrabold uppercase tracking-widest text-[#1E5FD8] block mb-0.5">
                Struktur Organisasi Resmi
              </span>
              <h3 class="text-base sm:text-lg font-bold text-[#0B2A5B]">
                Bagan Susunan Organisasi Disporapar Kabupaten Sukamara
              </h3>
              <p class="text-xs text-gray-500">
                Sesuai Lampiran Peraturan Bupati Sukamara Nomor 55 Tahun 2022
              </p>
            </div>

            <!-- Legend: Garis Komando & Koordinasi -->
            <div class="inline-flex items-center gap-4 text-xs text-gray-600 bg-slate-50 px-3.5 py-2 rounded-xl border border-slate-200 shrink-0 self-start sm:self-auto">
              <div class="flex items-center gap-2">
                <span class="w-5 h-0.5 bg-slate-900 inline-block rounded-full"></span>
                <span class="font-semibold text-slate-800">Garis Lini / Komando</span>
              </div>
              <div class="flex items-center gap-2">
                <span class="w-5 h-0.5 border-b-2 border-dashed border-slate-500 inline-block"></span>
                <span class="font-semibold text-slate-800">Garis Koordinasi</span>
              </div>
            </div>
          </div>

          <!-- Petunjuk geser di HP -->
          <div class="sm:hidden mb-2 text-center">
            <span class="inline-block text-[11px] text-gray-400 bg-gray-50 px-3 py-1 rounded-full border border-gray-100">
              👉 Geser ke samping untuk melihat bagan lengkap
            </span>
          </div>

          <!-- SVG Bagan SOTK 100% Persis Dokumen Resmi -->
          <div class="overflow-x-auto -mx-2 sm:mx-0 px-2 sm:px-0 py-2">
            <div class="min-w-[860px] max-w-5xl mx-auto">
              <svg 
                viewBox="0 0 1200 820" 
                class="w-full h-auto block select-none font-sans"
                xmlns="http://www.w3.org/2000/svg"
                role="img"
                aria-label="Bagan Struktur Organisasi Dinas Kepemudaan, Olahraga dan Pariwisata Kabupaten Sukamara"
              >
                <defs>
                  <filter id="boxShadow" x="-10%" y="-10%" width="120%" height="130%" filterUnits="userSpaceOnUse">
                    <feDropShadow dx="0" dy="2" stdDeviation="2.5" flood-color="#0F172A" flood-opacity="0.08" />
                  </filter>
                </defs>

                <!-- ================= GARIS-GARIS KONEKTOR ================= -->

                <!-- 1. Garis Komando Pusat Vertikal (Kepala Dinas -> UPT) -->
                <path d="M 600,105 L 600,710" stroke="#0F172A" stroke-width="2" stroke-linecap="round" />

                <!-- 2. Cabang Kanan Atas: Kepala Dinas -> Sekretariat Dinas -->
                <path d="M 600,135 L 890,135 L 890,165" stroke="#0F172A" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" fill="none" />

                <!-- 3. Cabang Kiri Atas: Garis Komando -> Kelompok Jabatan Fungsional -->
                <path d="M 600,210 L 180,210 L 180,235" stroke="#0F172A" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" fill="none" />

                <!-- 4. Cabang Komando Sekretariat -> 2 Subbagian -->
                <path d="M 890,235 L 890,260" stroke="#0F172A" stroke-width="2" stroke-linecap="round" />
                <path d="M 750,285 L 750,260 L 1030,260 L 1030,285" stroke="#0F172A" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" fill="none" />

                <!-- 5. Cabang Komando ke 2 Bidang (Kepemudaan & Pariwisata) -->
                <path d="M 350,470 L 350,440 L 850,440 L 850,470" stroke="#0F172A" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" fill="none" />

                <!-- 6. Garis Lini/Solid Luar: Sekretariat -> Putar Luar -> Bawah Bidang -> Fungsional -->
                <path d="M 1030,235 L 1170,235 L 1170,660 L 154,660 L 154,320" stroke="#0F172A" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" fill="none" />
                <!-- Cabang Lini Tegak ke Bawah Bidang Kepemudaan & Pariwisata -->
                <path d="M 380,660 L 380,550" stroke="#0F172A" stroke-width="2" stroke-linecap="round" />
                <path d="M 880,660 L 880,550" stroke="#0F172A" stroke-width="2" stroke-linecap="round" />

                <!-- 7. Garis Koordinasi Putus-Putus: Sekretariat -> Bawah Subbag Umum -> Bawah Bidang -> Fungsional -->
                <path d="M 970,235 L 970,255 L 1140,255 L 1140,620 L 180,620 L 180,320" stroke="#475569" stroke-width="2" stroke-dasharray="6,4" stroke-linecap="round" stroke-linejoin="round" fill="none" />
                <!-- Cabang Koordinasi Tegak ke Bawah Bidang Kepemudaan & Pariwisata -->
                <path d="M 320,620 L 320,550" stroke="#475569" stroke-width="2" stroke-dasharray="6,4" stroke-linecap="round" />
                <path d="M 820,620 L 820,550" stroke="#475569" stroke-width="2" stroke-dasharray="6,4" stroke-linecap="round" />


                <!-- ================= KOTAK-KOTAK PEJABAT & UNIT ================= -->

                <!-- KOTAK 1: KEPALA DINAS (Paling Atas) -->
                <g filter="url(#boxShadow)">
                  <rect x="430" y="45" width="340" height="60" rx="4" ry="4" fill="#FFFFFF" stroke="#0B2A5B" stroke-width="2" />
                  <rect x="430" y="45" width="340" height="26" rx="4" ry="4" fill="#0B2A5B" />
                  <rect x="430" y="67" width="340" height="4" fill="#0B2A5B" />
                  <text x="600" y="62" text-anchor="middle" fill="#FFFFFF" font-size="11.5" font-weight="700" letter-spacing="1.5">
                    {struktur.kepalaDinas.jabatan}
                  </text>
                  <text x="600" y="90" text-anchor="middle" fill="#0F172A" font-size="13.5" font-weight="800">
                    {struktur.kepalaDinas.nama}
                  </text>
                </g>

                <!-- KOTAK 2: SEKRETARIAT DINAS (Kanan Atas) -->
                <g filter="url(#boxShadow)">
                  <rect x="750" y="165" width="280" height="70" rx="4" ry="4" fill="#FFFFFF" stroke="#0B2A5B" stroke-width="2" />
                  <rect x="750" y="165" width="280" height="26" rx="4" ry="4" fill="#1E5FD8" />
                  <rect x="750" y="187" width="280" height="4" fill="#1E5FD8" />
                  <text x="890" y="182" text-anchor="middle" fill="#FFFFFF" font-size="11" font-weight="700" letter-spacing="1">
                    {struktur.sekretariat.jabatan}
                  </text>
                  <text x="890" y="214" text-anchor="middle" fill="#0F172A" font-size="13" font-weight="800">
                    {struktur.sekretariat.nama}
                  </text>
                </g>

                <!-- KOTAK 3: SUBBAGIAN PERENCANAAN, KEUANGAN DAN PELAPORAN -->
                <g filter="url(#boxShadow)">
                  <rect x="635" y="285" width="230" height="75" rx="4" ry="4" fill="#FFFFFF" stroke="#0B2A5B" stroke-width="1.8" />
                  <text x="750" y="306" text-anchor="middle" fill="#475569" font-size="9.5" font-weight="700">
                    SUBBAGIAN PERENCANAAN,
                  </text>
                  <text x="750" y="320" text-anchor="middle" fill="#475569" font-size="9.5" font-weight="700">
                    KEUANGAN DAN PELAPORAN
                  </text>
                  <text x="750" y="343" text-anchor="middle" fill="#0B2A5B" font-size="11.5" font-weight="800">
                    {struktur.sekretariat.subbagian[0].nama}
                  </text>
                </g>

                <!-- KOTAK 4: SUBBAGIAN UMUM DAN KEPEGAWAIAN -->
                <g filter="url(#boxShadow)">
                  <rect x="915" y="285" width="230" height="75" rx="4" ry="4" fill="#FFFFFF" stroke="#0B2A5B" stroke-width="1.8" />
                  <text x="1030" y="306" text-anchor="middle" fill="#475569" font-size="9.5" font-weight="700">
                    SUBBAGIAN UMUM DAN
                  </text>
                  <text x="1030" y="320" text-anchor="middle" fill="#475569" font-size="9.5" font-weight="700">
                    KEPEGAWAIAN
                  </text>
                  <text x="1030" y="343" text-anchor="middle" fill="#0B2A5B" font-size="10.5" font-weight="800">
                    {struktur.sekretariat.subbagian[1].nama}
                  </text>
                </g>

                <!-- KOTAK 5: KELOMPOK JABATAN FUNGSIONAL (Kiri Atas dengan 10 Slot Grid di Bawah) -->
                <g filter="url(#boxShadow)">
                  <!-- Kotak Induk Judul -->
                  <rect x="50" y="235" width="260" height="50" rx="3" ry="3" fill="#FFFFFF" stroke="#0B2A5B" stroke-width="1.8" />
                  <text x="180" y="256" text-anchor="middle" fill="#0B2A5B" font-size="11.5" font-weight="800" letter-spacing="0.5">
                    KELOMPOK
                  </text>
                  <text x="180" y="272" text-anchor="middle" fill="#0B2A5B" font-size="11.5" font-weight="800" letter-spacing="0.5">
                    JABATAN FUNGSIONAL
                  </text>

                  <!-- Kotak Grid 10 Kolom Slot di Bawah (Sesuai Lampiran Perbup) -->
                  <rect x="50" y="285" width="260" height="35" fill="#F8FAFC" stroke="#0B2A5B" stroke-width="1.8" />
                  <line x1="76" y1="285" x2="76" y2="320" stroke="#0B2A5B" stroke-width="1" />
                  <line x1="102" y1="285" x2="102" y2="320" stroke="#0B2A5B" stroke-width="1" />
                  <line x1="128" y1="285" x2="128" y2="320" stroke="#0B2A5B" stroke-width="1" />
                  <line x1="154" y1="285" x2="154" y2="320" stroke="#0B2A5B" stroke-width="1" />
                  <line x1="180" y1="285" x2="180" y2="320" stroke="#0B2A5B" stroke-width="1" />
                  <line x1="206" y1="285" x2="206" y2="320" stroke="#0B2A5B" stroke-width="1" />
                  <line x1="232" y1="285" x2="232" y2="320" stroke="#0B2A5B" stroke-width="1" />
                  <line x1="258" y1="285" x2="258" y2="320" stroke="#0B2A5B" stroke-width="1" />
                  <line x1="284" y1="285" x2="284" y2="320" stroke="#0B2A5B" stroke-width="1" />
                </g>

                <!-- KOTAK 6: BIDANG KEPEMUDAAN DAN OLAH RAGA (Kiri Tengah) -->
                <g filter="url(#boxShadow)">
                  <rect x="210" y="470" width="280" height="80" rx="4" ry="4" fill="#FFFFFF" stroke="#0B2A5B" stroke-width="2" />
                  <rect x="210" y="470" width="280" height="4" fill="#B81267" />
                  <text x="350" y="497" text-anchor="middle" fill="#B81267" font-size="11" font-weight="800" letter-spacing="0.5">
                    BIDANG KEPEMUDAAN DAN
                  </text>
                  <text x="350" y="513" text-anchor="middle" fill="#B81267" font-size="11" font-weight="800" letter-spacing="0.5">
                    OLAH RAGA
                  </text>
                  <text x="350" y="536" text-anchor="middle" fill="#0F172A" font-size="13" font-weight="800">
                    {struktur.bidang[0].nama}
                  </text>
                </g>

                <!-- KOTAK 7: BIDANG PARIWISATA (Kanan Tengah) -->
                <g filter="url(#boxShadow)">
                  <rect x="710" y="470" width="280" height="80" rx="4" ry="4" fill="#FFFFFF" stroke="#0B2A5B" stroke-width="2" />
                  <rect x="710" y="470" width="280" height="4" fill="#0F766E" />
                  <text x="850" y="505" text-anchor="middle" fill="#0F766E" font-size="11.5" font-weight="800" letter-spacing="0.5">
                    {struktur.bidang[1].jabatan}
                  </text>
                  <text x="850" y="532" text-anchor="middle" fill="#0F172A" font-size="13" font-weight="800">
                    {struktur.bidang[1].nama}
                  </text>
                </g>

                <!-- KOTAK 8: UPT (3 Kotak Bertumpuk Sesuai Lampiran Perbup) -->
                <g>
                  <!-- Kartu Belakang 3 -->
                  <rect x="546" y="726" width="140" height="50" rx="3" ry="3" fill="#E2E8F0" stroke="#0B2A5B" stroke-width="1.2" />
                  <!-- Kartu Tengah 2 -->
                  <rect x="538" y="718" width="140" height="50" rx="3" ry="3" fill="#F1F5F9" stroke="#0B2A5B" stroke-width="1.5" />
                  <!-- Kartu Depan 1 -->
                  <g filter="url(#boxShadow)">
                    <rect x="530" y="710" width="140" height="50" rx="3" ry="3" fill="#FFFFFF" stroke="#0B2A5B" stroke-width="2" />
                    <text x="600" y="733" text-anchor="middle" fill="#0B2A5B" font-size="13.5" font-weight="800" letter-spacing="1">
                      {struktur.upt.jabatan}
                    </text>
                    <text x="600" y="749" text-anchor="middle" fill="#64748B" font-size="9" font-weight="600">
                      (Unit Pelaksana Teknis)
                    </text>
                  </g>
                </g>

              </svg>
            </div>
          </div>

          <!-- Bottom caption note -->
          <div class="mt-4 pt-4 border-t border-gray-100 flex flex-col sm:flex-row items-center justify-between text-xs text-gray-500 gap-2">
            <p>
              * Bagan Struktur Organisasi disusun 100% presisi berdasarkan <strong>Lampiran Peraturan Bupati Sukamara Nomor 55 Tahun 2022</strong>.
            </p>
            <span class="text-[11px] font-semibold text-blue-700 bg-blue-50 px-2.5 py-1 rounded-md">
              SOTK Disporapar Sukamara
            </span>
          </div>

        </div>

      </div>

      <!-- PANEL 2: Tugas Pokok & 16 Fungsi (Hidden by default) -->
      <div id="panel-tupoksi" role="tabpanel" aria-labelledby="tab-btn-tupoksi" class="hidden space-y-6">
        
        <!-- Tugas Pokok Highlight -->
        <div class="bg-gradient-to-r from-blue-900 to-[#0B2A5B] text-white rounded-2xl p-6 sm:p-7 shadow-sm">
          <div class="flex items-center gap-2 mb-2 text-sky-300">
            <CheckCircle2 class="w-5 h-5" />
            <h3 class="text-xs font-bold uppercase tracking-wider">Tugas Pokok Dinas</h3>
          </div>
          <p class="text-sm sm:text-base leading-relaxed font-medium text-blue-50">
            {tugasPokok}
          </p>
        </div>

        <!-- 16 Fungsi Grid -->
        <div class="bg-white rounded-2xl border border-gray-200 p-6 sm:p-8 shadow-xs space-y-4">
          <div class="flex items-center justify-between pb-3 border-b border-gray-100">
            <div>
              <h3 class="text-lg font-bold text-gray-900">16 Fungsi Dinas</h3>
              <p class="text-xs text-gray-500">
                Penyelenggaraan fungsi teknis dan administratif Disporapar Kabupaten Sukamara.
              </p>
            </div>
            <span class="text-xs font-bold px-2.5 py-1 rounded-md bg-blue-50 text-[#1E5FD8]">
              Pasal 4 Ayat (2)
            </span>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-3.5 pt-2">
            {fungsi.map((item, idx) => (
              <div class="flex items-start gap-3 p-3.5 rounded-xl bg-slate-50 hover:bg-blue-50/50 transition-colors border border-slate-100">
                <span class="w-6 h-6 rounded-full bg-white text-[#1E5FD8] font-bold text-xs flex items-center justify-center shrink-0 shadow-2xs border border-gray-100 mt-0.5">
                  {idx + 1}
                </span>
                <p class="text-xs sm:text-sm text-gray-700 leading-relaxed">
                  {item}
                </p>
              </div>
            ))}
          </div>
        </div>

      </div>
    </div>

  </div>
</section>

<script>
  // ponytail: Lightweight tab switcher with ARIA tab semantics, zero library dependency
  function initProfileTabs() {
    const btnStruktur = document.getElementById('tab-btn-struktur');
    const btnTupoksi = document.getElementById('tab-btn-tupoksi');
    const panelStruktur = document.getElementById('panel-struktur');
    const panelTupoksi = document.getElementById('panel-tupoksi');

    if (!btnStruktur || !btnTupoksi || !panelStruktur || !panelTupoksi) return;

    function switchTab(activeBtn: HTMLElement, inactiveBtn: HTMLElement, activePanel: HTMLElement, inactivePanel: HTMLElement) {
      activeBtn.setAttribute('aria-selected', 'true');
      activeBtn.classList.add('border-[#1E5FD8]', 'text-[#1E5FD8]', 'font-bold');
      activeBtn.classList.remove('border-transparent', 'text-gray-500');

      inactiveBtn.setAttribute('aria-selected', 'false');
      inactiveBtn.classList.remove('border-[#1E5FD8]', 'text-[#1E5FD8]', 'font-bold');
      inactiveBtn.classList.add('border-transparent', 'text-gray-500');

      activePanel.classList.remove('hidden');
      inactivePanel.classList.add('hidden');
    }

    btnStruktur.addEventListener('click', () => {
      switchTab(btnStruktur, btnTupoksi, panelStruktur, panelTupoksi);
    });

    btnTupoksi.addEventListener('click', () => {
      switchTab(btnTupoksi, btnStruktur, panelTupoksi, panelStruktur);
    });
  }

  initProfileTabs();
  document.addEventListener('astro:page-load', initProfileTabs);
</script>
