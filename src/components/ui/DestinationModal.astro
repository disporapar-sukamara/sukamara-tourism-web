---
import { getCollection } from 'astro:content';
import { X, MapPin, Ticket, Compass, ArrowRight, ExternalLink } from 'lucide-astro';

const allDestinations = await getCollection('destinasi');

const categoryColors: Record<string, string> = {
  'Wisata Bahari': 'bg-sky-500 text-white',
  'Wisata Alam': 'bg-emerald-600 text-white',
  'Wisata Budaya': 'bg-amber-600 text-white',
  'Wisata Religi': 'bg-teal-600 text-white',
};

const items = allDestinations.map((d) => ({
  id: d.id,
  nama: d.data.nama,
  kategori: d.data.kategori,
  kategoriColor: categoryColors[d.data.kategori] || 'bg-blue-600 text-white',
  kecamatan: d.data.kecamatan,
  alamat: d.data.alamat || d.data.kecamatan,
  deskripsi: d.data.deskripsi,
  gambar: d.data.gambar,
  tiket: d.data.tiket || 'Gratis',
  latitude: d.data.latitude ? Number(d.data.latitude) : null,
  longitude: d.data.longitude ? Number(d.data.longitude) : null,
  unggulan: d.data.unggulan,
}));
---

<!-- 1. Modal Detail Destinasi Tunggal -->
<div 
  id="dest-detail-modal" 
  class="fixed inset-0 z-50 hidden bg-navy-900/60 backdrop-blur-md p-3 sm:p-6 overflow-y-auto"
  role="dialog" 
  aria-modal="true" 
  aria-label="Detail Destinasi Wisata"
>
  <div class="min-h-full flex items-center justify-center py-4">
    <div class="bg-white w-full max-w-xl rounded-2xl shadow-2xl border border-gray-100 overflow-hidden flex flex-col animate-in fade-in zoom-in-95">
      
      <!-- Modal Header Image -->
      <div class="relative aspect-[16/9] w-full bg-gray-100 overflow-hidden">
        <img 
          id="dest-modal-img" 
          src="" 
          alt="" 
          class="w-full h-full object-cover" 
        />
        <!-- Close Button Over Image -->
        <button 
          type="button" 
          id="dest-modal-close" 
          class="absolute top-3 right-3 w-11 h-11 rounded-full bg-black/60 hover:bg-black/80 text-white flex items-center justify-center transition-colors cursor-pointer"
          aria-label="Tutup detail destinasi"
        >
          <X class="w-5 h-5" />
        </button>

        <!-- Category Badge -->
        <span 
          id="dest-modal-category" 
          class="absolute bottom-3 left-3 px-3 py-1 rounded-lg text-xs font-bold tracking-wider uppercase shadow-md bg-blue-600 text-white"
        >
        </span>
      </div>

      <!-- Modal Body Content -->
      <div class="p-5 sm:p-6 space-y-4">
        <div>
          <div class="flex items-center gap-1.5 text-xs text-gray-500 mb-1">
            <MapPin class="w-3.5 h-3.5 text-[#B81267] shrink-0" />
            <span id="dest-modal-kecamatan" class="font-medium"></span>
          </div>
          <h2 id="dest-modal-title" class="text-xl sm:text-2xl font-black text-[#0B2A5B] leading-tight"></h2>
        </div>

        <!-- Meta info pill: Tiket & Alamat -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5 pt-1 text-xs">
          <div class="flex items-center gap-2 p-2.5 rounded-xl bg-gray-50 border border-gray-100">
            <Ticket class="w-4 h-4 text-emerald-600 shrink-0" />
            <div>
              <span class="text-gray-500 block text-[10px]">Tiket Masuk:</span>
              <span id="dest-modal-tiket" class="font-bold text-gray-700"></span>
            </div>
          </div>
          <div class="flex items-center gap-2 p-2.5 rounded-xl bg-gray-50 border border-gray-100">
            <MapPin class="w-4 h-4 text-blue-600 shrink-0" />
            <div class="min-w-0">
              <span class="text-gray-500 block text-[10px]">Alamat:</span>
              <span id="dest-modal-alamat" class="font-bold text-gray-700 truncate block"></span>
            </div>
          </div>
        </div>

        <!-- Deskripsi Lengkap -->
        <div>
          <h3 class="text-xs font-bold uppercase tracking-wider text-gray-500 mb-1.5">Deskripsi Destinasi</h3>
          <p id="dest-modal-desc" class="text-xs sm:text-sm text-gray-600 leading-relaxed"></p>
        </div>

        <!-- Action Buttons -->
        <div class="pt-3 border-t border-gray-100 flex flex-col sm:flex-row gap-2.5">
          <a 
            id="dest-modal-gmaps" 
            href="#" 
            target="_blank" 
            rel="noopener noreferrer" 
            class="flex-1 py-2.5 px-4 rounded-xl bg-[#0E9F8E] hover:bg-[#0b8274] text-white text-xs font-bold transition-all shadow-xs flex items-center justify-center gap-2"
          >
            <Compass class="w-4 h-4" />
            <span>Buka Rute di Google Maps</span>
            <ExternalLink class="w-3.5 h-3.5" />
          </a>
          <button 
            type="button" 
            id="dest-modal-close-btn" 
            class="py-2.5 px-4 rounded-xl bg-gray-100 hover:bg-gray-200 text-gray-700 text-xs font-bold transition-colors cursor-pointer"
          >
            Tutup
          </button>
        </div>

      </div>

    </div>
  </div>
</div>

<!-- 2. Modal Katalog Semua Destinasi -->
<div 
  id="dest-all-modal" 
  class="fixed inset-0 z-50 hidden bg-navy-900/60 backdrop-blur-md p-3 sm:p-6 md:p-8 overflow-y-auto"
  role="dialog" 
  aria-modal="true" 
  aria-label="Semua Destinasi Wisata Sukamara"
>
  <div class="min-h-full flex items-center justify-center py-4">
    <div class="bg-white w-full max-w-4xl rounded-2xl shadow-2xl border border-gray-100 overflow-hidden flex flex-col animate-in fade-in zoom-in-95 max-h-[90vh]">
      
      <!-- Header -->
      <div class="p-4 sm:p-5 border-b border-gray-100 flex items-center justify-between gap-4 bg-gray-50/50">
        <div>
          <h2 class="text-lg sm:text-xl font-black text-[#0B2A5B]">Katalog Seluruh Destinasi Wisata</h2>
          <p class="text-xs text-gray-500">Jelajahi 9 destinasi wisata alam, bahari, religi, dan budaya di Kabupaten Sukamara</p>
        </div>
        <button 
          type="button" 
          id="dest-all-close" 
          class="p-2 rounded-xl text-gray-500 hover:text-gray-700 hover:bg-gray-200 transition-colors cursor-pointer w-11 h-11 flex items-center justify-center"
          aria-label="Tutup katalog destinasi"
        >
          <X class="w-5 h-5" />
        </button>
      </div>

      <!-- Filter Buttons -->
      <div class="px-4 py-2.5 border-b border-gray-100 flex items-center gap-1.5 overflow-x-auto text-xs bg-white">
        <span class="text-gray-600 text-[11px] font-medium mr-1 shrink-0">Filter:</span>
        <button type="button" class="dest-filter-btn px-3 py-1 rounded-full font-bold bg-[#1E5FD8] text-white shadow-2xs" data-kategori="all">Semua (9)</button>
        <button type="button" class="dest-filter-btn px-3 py-1 rounded-full font-semibold bg-white border border-gray-200 text-gray-700 hover:bg-gray-50" data-kategori="Wisata Bahari">Wisata Bahari</button>
        <button type="button" class="dest-filter-btn px-3 py-1 rounded-full font-semibold bg-white border border-gray-200 text-gray-700 hover:bg-gray-50" data-kategori="Wisata Alam">Wisata Alam</button>
        <button type="button" class="dest-filter-btn px-3 py-1 rounded-full font-semibold bg-white border border-gray-200 text-gray-700 hover:bg-gray-50" data-kategori="Wisata Budaya">Wisata Budaya</button>
        <button type="button" class="dest-filter-btn px-3 py-1 rounded-full font-semibold bg-white border border-gray-200 text-gray-700 hover:bg-gray-50" data-kategori="Wisata Religi">Wisata Religi</button>
      </div>

      <!-- Grid Cards -->
      <div class="p-4 sm:p-6 overflow-y-auto grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {items.map((item) => (
          <div 
            class="dest-catalog-card bg-white rounded-xl overflow-hidden border border-gray-100 shadow-xs hover:shadow-lg transition-all duration-200 flex flex-col justify-between group cursor-pointer hover:-translate-y-1"
            data-dest-id={item.id}
            data-dest-kategori={item.kategori}
          >
            <div>
              <div class="relative aspect-[16/10] w-full overflow-hidden bg-gray-100">
                <img src={item.gambar} alt={item.nama} width="300" height="190" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" decoding="async" />
                <span class={`absolute bottom-2 left-2 px-2 py-0.5 rounded text-[9px] font-bold tracking-wider uppercase shadow-xs ${item.kategoriColor}`}>
                  {item.kategori}
                </span>
              </div>
              <div class="p-3.5">
                <div class="flex items-center gap-1 text-[11px] text-gray-600 mb-1">
                  <MapPin class="w-3 h-3 text-[#B81267]" />
                  <span>{item.kecamatan}</span>
                </div>
                <h3 class="font-bold text-[#0B2A5B] text-sm group-hover:text-[#1E5FD8] transition-colors leading-snug line-clamp-1">
                  {item.nama}
                </h3>
                <h4 class="font-bold text-sm text-[#0B2A5B] group-hover:text-[#1E5FD8] transition-colors leading-snug mb-1">
                  {item.nama}
                </h4>
                <p class="text-[11px] text-gray-500 line-clamp-2 leading-relaxed">
                  {item.deskripsi}
                </p>
              </div>
            </div>
            <div class="p-3.5 pt-0">
              <div class="pt-2.5 border-t border-gray-100 flex items-center justify-between text-xs font-bold text-[#1E5FD8]">
                <span>Lihat Detail</span>
                <ArrowRight class="w-3.5 h-3.5 group-hover:translate-x-1 transition-transform" />
              </div>
            </div>
          </div>
        ))}
      </div>

    </div>
  </div>
</div>

<!-- Embedded JSON Data for client script -->
<script id="destination-data" type="application/json" set:html={JSON.stringify(items)} />

<script>
  function initDestinationModals() {
    const detailModal = document.getElementById('dest-detail-modal');
    const allModal = document.getElementById('dest-all-modal');
    const dataTag = document.getElementById('destination-data');

    if (!detailModal || !allModal || !dataTag) return;

    let destinations: Array<{
      id: string;
      nama: string;
      kategori: string;
      kategoriColor: string;
      kecamatan: string;
      alamat: string;
      deskripsi: string;
      gambar: string;
      tiket: string;
      latitude: number | null;
      longitude: number | null;
      unggulan: boolean;
    }> = [];

    try {
      destinations = JSON.parse(dataTag.textContent || '[]');
    } catch {
      destinations = [];
    }

    const modalImg = document.getElementById('dest-modal-img') as HTMLImageElement | null;
    const modalCategory = document.getElementById('dest-modal-category');
    const modalTitle = document.getElementById('dest-modal-title');
    const modalKecamatan = document.getElementById('dest-modal-kecamatan');
    const modalAlamat = document.getElementById('dest-modal-alamat');
    const modalTiket = document.getElementById('dest-modal-tiket');
    const modalDesc = document.getElementById('dest-modal-desc');
    const modalGmaps = document.getElementById('dest-modal-gmaps') as HTMLAnchorElement | null;

    function openDetail(id: string) {
      const item = destinations.find((d) => d.id === id);
      if (!item) return;

      if (modalImg) {
        modalImg.src = item.gambar;
        modalImg.alt = item.nama;
      }
      if (modalCategory) {
        modalCategory.textContent = item.kategori;
        modalCategory.className = `absolute bottom-3 left-3 px-3 py-1 rounded-lg text-xs font-bold tracking-wider uppercase shadow-md ${item.kategoriColor}`;
      }
      if (modalTitle) modalTitle.textContent = item.nama;
      if (modalKecamatan) modalKecamatan.textContent = item.kecamatan;
      if (modalAlamat) modalAlamat.textContent = item.alamat;
      if (modalTiket) modalTiket.textContent = item.tiket;
      if (modalDesc) modalDesc.textContent = item.deskripsi;

      if (modalGmaps) {
        if (item.latitude && item.longitude) {
          modalGmaps.href = `https://www.google.com/maps/dir/?api=1&destination=${item.latitude},${item.longitude}`;
          modalGmaps.classList.remove('hidden');
        } else {
          modalGmaps.href = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(item.nama + ' Sukamara')}`;
        }
      }

      detailModal?.classList.remove('hidden');
      document.body.style.overflow = 'hidden';
    }

    function closeDetail() {
      detailModal?.classList.add('hidden');
      if (allModal?.classList.contains('hidden')) {
        document.body.style.overflow = '';
      }
    }

    function openAll() {
      allModal?.classList.remove('hidden');
      document.body.style.overflow = 'hidden';
    }

    function closeAll() {
      allModal?.classList.add('hidden');
      if (detailModal?.classList.contains('hidden')) {
        document.body.style.overflow = '';
      }
    }

    // Close buttons
    document.getElementById('dest-modal-close')?.addEventListener('click', closeDetail);
    document.getElementById('dest-modal-close-btn')?.addEventListener('click', closeDetail);
    document.getElementById('dest-all-close')?.addEventListener('click', closeAll);

    detailModal.addEventListener('click', (e) => {
      if (e.target === detailModal) closeDetail();
    });
    allModal.addEventListener('click', (e) => {
      if (e.target === allModal) closeAll();
    });

    // Keyboard ESC
    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        if (!detailModal.classList.contains('hidden')) closeDetail();
        else if (!allModal.classList.contains('hidden')) closeAll();
      }
    });

    // Catalog filter buttons
    const filterBtns = allModal.querySelectorAll<HTMLButtonElement>('.dest-filter-btn');
    const cards = allModal.querySelectorAll<HTMLElement>('.dest-catalog-card');

    filterBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const kat = btn.dataset.kategori;
        filterBtns.forEach((b) => {
          if (b === btn) {
            b.classList.add('bg-[#1E5FD8]', 'text-white', 'font-bold', 'shadow-2xs');
            b.classList.remove('bg-white', 'text-gray-600', 'border-gray-200');
          } else {
            b.classList.remove('bg-[#1E5FD8]', 'text-white', 'font-bold', 'shadow-2xs');
            b.classList.add('bg-white', 'text-gray-600', 'border-gray-200');
          }
        });

        cards.forEach((card) => {
          if (kat === 'all' || card.dataset.destKategori === kat) {
            card.classList.remove('hidden');
          } else {
            card.classList.add('hidden');
          }
        });
      });
    });

    // Click card in catalog to open detail
    cards.forEach((card) => {
      card.addEventListener('click', () => {
        const id = card.dataset.destId;
        if (id) {
          openDetail(id);
        }
      });
    });

    // Expose globally
    (window as any).openDestinationDetail = openDetail;
    (window as any).openDestinationModal = openDetail;
    (window as any).openAllDestinationsModal = openAll;
  }

  initDestinationModals();
  document.addEventListener('astro:after-swap', initDestinationModals);
</script>
