---
import { getCollection } from 'astro:content';
import { X, Calendar, MapPin, ArrowRight, CalendarPlus } from 'lucide-astro';

const allEvents = await getCollection('event');

const categoryStyles: Record<string, { tag: string; dateBg: string; text: string }> = {
  'EVENT WISATA': {
    tag: 'bg-pink-100 text-[#D6197A] border-pink-200',
    dateBg: 'bg-gradient-to-br from-pink-500 to-[#D6197A] text-white',
    text: 'text-[#D6197A]',
  },
  'EVENT BUDAYA': {
    tag: 'bg-amber-100 text-amber-800 border-amber-200',
    dateBg: 'bg-gradient-to-br from-amber-500 to-amber-600 text-white',
    text: 'text-amber-600',
  },
  'EVENT OLAHRAGA': {
    tag: 'bg-blue-100 text-[#1E5FD8] border-blue-200',
    dateBg: 'bg-gradient-to-br from-blue-500 to-[#1E5FD8] text-white',
    text: 'text-[#1E5FD8]',
  },
  'EVENT PEMUDA': {
    tag: 'bg-emerald-100 text-emerald-800 border-emerald-200',
    dateBg: 'bg-gradient-to-br from-emerald-500 to-emerald-600 text-white',
    text: 'text-emerald-600',
  },
};

const items = allEvents.map((item) => {
  const style = categoryStyles[item.data.kategori] || categoryStyles['EVENT WISATA'];
  return {
    id: item.id,
    judul: item.data.judul,
    kategori: item.data.kategori,
    kategoriLabel: item.data.kategori.replace('EVENT ', ''),
    tanggal: item.data.tanggal,
    bulanTahun: item.data.bulanTahun,
    lokasi: item.data.lokasi,
    style,
  };
});
---

<!-- 1. Modal Detail Kegiatan Event -->
<div 
  id="event-detail-modal" 
  class="fixed inset-0 z-50 hidden bg-navy-900/60 backdrop-blur-md p-3 sm:p-6 overflow-y-auto"
  role="dialog" 
  aria-modal="true" 
  aria-label="Detail Kegiatan Event"
>
  <div class="min-h-full flex items-center justify-center py-4">
    <div class="bg-white w-full max-w-lg rounded-2xl shadow-2xl border border-gray-100 overflow-hidden flex flex-col animate-in fade-in zoom-in-95">
      
      <!-- Top Banner Header -->
      <div class="p-5 sm:p-6 bg-gradient-to-r from-[#0B2A5B] to-[#1E5FD8] text-white relative">
        <button 
          type="button" 
          id="event-modal-close" 
          class="absolute top-4 right-4 w-11 h-11 rounded-full bg-white/20 hover:bg-white/30 text-white flex items-center justify-center transition-colors cursor-pointer"
          aria-label="Tutup detail event"
        >
          <X class="w-5 h-5" />
        </button>

        <div class="flex items-center gap-4">
          <!-- Big Date Badge -->
          <div id="event-modal-datebox" class="w-16 h-16 rounded-2xl bg-white text-[#0B2A5B] flex flex-col items-center justify-center shadow-lg shrink-0">
            <span id="event-modal-day" class="text-2xl font-black leading-none">20</span>
            <span id="event-modal-month" class="text-[10px] font-bold uppercase tracking-wider opacity-90 mt-1">OKT 2026</span>
          </div>

          <div class="min-w-0 pr-6">
            <span id="event-modal-category" class="inline-block px-2.5 py-0.5 rounded-full text-[10px] font-bold border border-white/30 bg-white/20 uppercase tracking-wider mb-1.5">
              WISATA
            </span>
            <h2 id="event-modal-title" class="text-base sm:text-lg font-black leading-tight"></h2>
          </div>
        </div>
      </div>

      <!-- Content Area -->
      <div class="p-5 sm:p-6 space-y-4">
        <!-- Location & Time -->
        <div class="p-3.5 rounded-xl bg-gray-50 border border-gray-100 flex items-start gap-3">
          <div class="w-8 h-8 rounded-lg bg-pink-100 text-[#B81267] flex items-center justify-center shrink-0">
            <MapPin class="w-4 h-4" />
          </div>
          <div>
            <span class="text-gray-600 block text-[11px] font-medium">Lokasi Pelaksanaan:</span>
            <span id="event-modal-location" class="font-bold text-gray-800 text-sm"></span>
          </div>
        </div>

        <!-- Agenda Rundown & Notes -->
        <div>
          <h3 class="text-xs font-bold uppercase tracking-wider text-gray-600 mb-2">Informasi & Rundown Kegiatan</h3>
          <p class="text-xs sm:text-sm text-gray-600 leading-relaxed">
            Kegiatan ini diselenggarakan secara terbuka untuk seluruh masyarakat Kabupaten Sukamara dan wisatawan. Dimeriahkan dengan panggung seni budaya daerah, pameran UMKM lokal, dan kompetisi kreatif.
          </p>
        </div>

        <!-- Action CTA -->
        <div class="pt-3 border-t border-gray-100 flex flex-col sm:flex-row gap-2.5">
          <a 
            id="event-modal-cal-btn" 
            href="#" 
            target="_blank" 
            rel="noopener noreferrer" 
            class="flex-1 py-2.5 px-4 rounded-xl bg-[#1E5FD8] hover:bg-blue-700 text-white text-xs font-bold transition-all shadow-xs flex items-center justify-center gap-2"
          >
            <CalendarPlus class="w-4 h-4" />
            <span>Simpan ke Google Calendar</span>
          </a>
          <button 
            type="button" 
            id="event-modal-close-btn" 
            class="py-2.5 px-4 rounded-xl bg-gray-100 hover:bg-gray-200 text-gray-700 text-xs font-bold transition-colors cursor-pointer"
          >
            Tutup
          </button>
        </div>

      </div>

    </div>
  </div>
</div>

<!-- 2. Modal Seluruh Kalender Event -->
<div 
  id="event-all-modal" 
  class="fixed inset-0 z-50 hidden bg-navy-900/60 backdrop-blur-md p-3 sm:p-6 md:p-8 overflow-y-auto"
  role="dialog" 
  aria-modal="true" 
  aria-label="Kalender Event Lengkap Sukamara"
>
  <div class="min-h-full flex items-center justify-center py-4">
    <div class="bg-white w-full max-w-3xl rounded-2xl shadow-2xl border border-gray-100 overflow-hidden flex flex-col animate-in fade-in zoom-in-95 max-h-[90vh]">
      
      <!-- Header -->
      <div class="p-4 sm:p-5 border-b border-gray-100 flex items-center justify-between gap-4 bg-gray-50/50">
        <div class="flex items-center gap-2.5">
          <div class="w-8 h-8 rounded-lg bg-pink-100 flex items-center justify-center text-[#B81267]">
            <Calendar class="w-5 h-5" />
          </div>
          <div>
            <h2 class="text-base sm:text-lg font-black text-[#0B2A5B]">Kalender Event Tahunan Sukamara</h2>
            <p class="text-xs text-gray-500">Agenda festival budaya, bahari, pemuda, dan kejuaraan olahraga sepanjang tahun</p>
          </div>
        </div>
        <button 
          type="button" 
          id="event-all-close" 
          class="p-2 rounded-xl text-gray-500 hover:text-gray-700 hover:bg-gray-200 transition-colors cursor-pointer w-11 h-11 flex items-center justify-center"
          aria-label="Tutup katalog event"
        >
          <X class="w-5 h-5" />
        </button>
      </div>

      <!-- Events List -->
      <div class="p-4 sm:p-6 overflow-y-auto space-y-3">
        {items.map((event) => (
          <div 
            class="event-catalog-item bg-white p-4 rounded-xl border border-gray-100 hover:border-blue-200 shadow-xs hover:shadow-md transition-all flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 cursor-pointer group"
            data-event-id={event.id}
          >
            <div class="flex items-start sm:items-center gap-3.5 min-w-0">
              <div class={`w-13 h-13 rounded-xl ${event.style.dateBg} flex flex-col items-center justify-center shadow-xs shrink-0 group-hover:scale-105 transition-transform`}>
                <span class="text-lg font-black leading-none">{event.tanggal}</span>
                <span class="text-[9px] font-bold uppercase tracking-wider opacity-90 mt-0.5">{event.bulanTahun}</span>
              </div>
              <div class="min-w-0">
                <span class={`px-2 py-0.5 rounded-full text-[9px] font-bold border tracking-wide uppercase mb-1 inline-block ${event.style.tag}`}>
                  {event.kategoriLabel}
                </span>
                <h3 class="font-extrabold text-[#0B2A5B] text-sm group-hover:text-[#1E5FD8] transition-colors leading-snug">
                  {event.judul}
                </h3>
                <div class="flex items-center gap-1.5 text-xs text-gray-600 mt-0.5">
                  <MapPin class="w-3 h-3 text-[#B81267]" />
                  <span>{event.lokasi}</span>
                </div>
              </div>
            </div>

            <div class="w-full sm:w-auto flex items-center justify-end">
              <span class="text-xs font-bold text-[#1E5FD8] group-hover:underline flex items-center gap-1">
                Detail Kegiatan <ArrowRight class="w-3.5 h-3.5 group-hover:translate-x-1 transition-transform" />
              </span>
            </div>
          </div>
        ))}
      </div>

    </div>
  </div>
</div>

<script id="event-data" type="application/json" set:html={JSON.stringify(items)} />

<script>
  function initEventModals() {
    const detailModal = document.getElementById('event-detail-modal');
    const allModal = document.getElementById('event-all-modal');
    const dataTag = document.getElementById('event-data');

    if (!detailModal || !allModal || !dataTag) return;

    let events: Array<{
      id: string;
      judul: string;
      kategori: string;
      kategoriLabel: string;
      tanggal: string;
      bulanTahun: string;
      lokasi: string;
    }> = [];

    try {
      events = JSON.parse(dataTag.textContent || '[]');
    } catch {
      events = [];
    }

    const modalDay = document.getElementById('event-modal-day');
    const modalMonth = document.getElementById('event-modal-month');
    const modalCategory = document.getElementById('event-modal-category');
    const modalTitle = document.getElementById('event-modal-title');
    const modalLocation = document.getElementById('event-modal-location');
    const modalCalBtn = document.getElementById('event-modal-cal-btn') as HTMLAnchorElement | null;

    function openDetail(id: string) {
      const item = events.find((e) => e.id === id);
      if (!item) return;

      if (modalDay) modalDay.textContent = item.tanggal;
      if (modalMonth) modalMonth.textContent = item.bulanTahun;
      if (modalCategory) modalCategory.textContent = item.kategoriLabel;
      if (modalTitle) modalTitle.textContent = item.judul;
      if (modalLocation) modalLocation.textContent = item.lokasi;

      if (modalCalBtn) {
        const title = encodeURIComponent(item.judul + ' Sukamara');
        const loc = encodeURIComponent(item.lokasi);
        modalCalBtn.href = `https://calendar.google.com/calendar/render?action=TEMPLATE&text=${title}&location=${loc}`;
      }

      detailModal?.classList.remove('hidden');
      document.body.style.overflow = 'hidden';
    }

    function closeDetail() {
      detailModal?.classList.add('hidden');
      if (allModal?.classList.contains('hidden')) {
        document.body.style.overflow = '';
      }
    }

    function openAll() {
      allModal?.classList.remove('hidden');
      document.body.style.overflow = 'hidden';
    }

    function closeAll() {
      allModal?.classList.add('hidden');
      if (detailModal?.classList.contains('hidden')) {
        document.body.style.overflow = '';
      }
    }

    document.getElementById('event-modal-close')?.addEventListener('click', closeDetail);
    document.getElementById('event-modal-close-btn')?.addEventListener('click', closeDetail);
    document.getElementById('event-all-close')?.addEventListener('click', closeAll);

    detailModal.addEventListener('click', (e) => {
      if (e.target === detailModal) closeDetail();
    });
    allModal.addEventListener('click', (e) => {
      if (e.target === allModal) closeAll();
    });

    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        if (!detailModal.classList.contains('hidden')) closeDetail();
        else if (!allModal.classList.contains('hidden')) closeAll();
      }
    });

    // Catalog items click
    allModal.querySelectorAll('.event-catalog-item').forEach((item) => {
      item.addEventListener('click', () => {
        const id = (item as HTMLElement).dataset.eventId;
        if (id) openDetail(id);
      });
    });

    (window as any).openEventDetail = openDetail;
    (window as any).openEventModal = openDetail;
    (window as any).openAllEventsModal = openAll;
  }

  initEventModals();
  document.addEventListener('astro:after-swap', initEventModals);
</script>
