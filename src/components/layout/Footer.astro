---
import { MapPin, Phone, Mail, ChevronRight, Facebook, Instagram, Youtube, Leaf } from 'lucide-astro';
import footerData from '../../content/footer/index.json';

const alamat = footerData?.alamat || 'Jl. Tjilik Riwut No. 01 Sukamara\nKabupaten Sukamara, Kalimantan Tengah 74772';
const telepon = footerData?.telepon || '(0532) 26710';
const email = footerData?.email || 'info@sukamarakab.go.id';
const facebookUrl = footerData?.facebookUrl || 'https://facebook.com';
const instagramUrl = footerData?.instagramUrl || 'https://instagram.com';
const youtubeUrl = footerData?.youtubeUrl || 'https://youtube.com';
const tiktokUrl = footerData?.tiktokUrl || 'https://tiktok.com';
const hashtag = footerData?.hashtag || '#Sukamara_Janga';
const copyright = footerData?.copyright || '© 2026 Pemerintah Kabupaten Sukamara. All rights reserved.';
---

<footer id="kontak" class="bg-[#0B2A5B] text-white pt-16 pb-8 border-t border-navy-800 scroll-mt-20">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-12 gap-10 pb-12 border-b border-white/10">
      
      <!-- Col 1: Brand & Contact (4 cols on lg) -->
      <div class="lg:col-span-4 space-y-4">
        <div class="flex items-center gap-3">
          <!-- Logo Pemkab -->
          <div class="flex items-center gap-2">
            <img 
              src="/images/branding/logo-kabupaten-sukamara.png" 
              alt="Pemkab Sukamara" 
              class="h-10 w-auto object-contain brightness-105"
            />
            <div class="flex flex-col">
              <span class="text-[9px] font-bold tracking-wider text-white/70 uppercase leading-none">
                Pemerintah Kabupaten
              </span>
              <span class="text-base font-black tracking-wider text-white leading-tight">
                SUKAMARA
              </span>
            </div>
          </div>
          <div class="h-6 w-px bg-white/20"></div>
          <!-- Logo Disporapar -->
          <div class="text-sm font-black tracking-tight leading-none text-white">
            <span class="text-blue-400">dis</span><span class="text-pink-400">pora</span><span class="text-teal-400">par</span>
            <div class="text-[7px] text-white/60 font-semibold tracking-wider">Kab. Sukamara</div>
          </div>
        </div>

        <div class="space-y-3 pt-2 text-xs text-white/80 leading-relaxed">
          <div class="flex items-start gap-2.5">
            <MapPin class="w-4 h-4 text-pink-400 shrink-0 mt-0.5" />
            <span>
              {alamat.split('\n').map((line, i) => (
                <Fragment>
                  {line}
                  {i < alamat.split('\n').length - 1 && <br />}
                </Fragment>
              ))}
            </span>
          </div>
          <div class="flex items-center gap-2.5">
            <Phone class="w-4 h-4 text-teal-400 shrink-0" />
            <a href={`tel:${telepon.replace(/[^0-9+]/g, '')}`} class="hover:text-white transition-colors">{telepon}</a>
          </div>
          <div class="flex items-center gap-2.5">
            <Mail class="w-4 h-4 text-blue-400 shrink-0" />
            <a href={`mailto:${email}`} class="hover:text-white transition-colors">{email}</a>
          </div>
        </div>
      </div>

      <!-- Col 2: Tautan Cepat 1 (2 cols) -->
      <div class="lg:col-span-2">
        <h4 class="text-sm font-bold text-white uppercase tracking-wider mb-4 border-l-2 border-[#1E5FD8] pl-2.5">
          Tautan Cepat
        </h4>
        <ul class="space-y-2 text-xs text-white/75">
          <li>
            <a href="/" class="flex items-center gap-1.5 hover:text-white hover:translate-x-1 transition-all">
              <ChevronRight class="w-3.5 h-3.5 text-blue-400" /> Beranda
            </a>
          </li>
          <li>
            <a href="#destinasi-unggulan" class="flex items-center gap-1.5 hover:text-white hover:translate-x-1 transition-all">
              <ChevronRight class="w-3.5 h-3.5 text-blue-400" /> Destinasi
            </a>
          </li>
          <li>
            <a href="#peta-wisata" class="flex items-center gap-1.5 hover:text-white hover:translate-x-1 transition-all">
              <ChevronRight class="w-3.5 h-3.5 text-blue-400" /> Peta Wisata
            </a>
          </li>
          <li>
            <a href="#agenda-mendatang" class="flex items-center gap-1.5 hover:text-white hover:translate-x-1 transition-all">
              <ChevronRight class="w-3.5 h-3.5 text-blue-400" /> Event
            </a>
          </li>
          <li>
            <a href="#kepemudaan-olahraga" class="flex items-center gap-1.5 hover:text-white hover:translate-x-1 transition-all">
              <ChevronRight class="w-3.5 h-3.5 text-blue-400" /> Pemuda
            </a>
          </li>
        </ul>
      </div>

      <!-- Col 3: Tautan Cepat 2 (2 cols) -->
      <div class="lg:col-span-2 pt-6 lg:pt-9">
        <ul class="space-y-2 text-xs text-white/75">
          <li>
            <a href="#kepemudaan-olahraga" class="flex items-center gap-1.5 hover:text-white hover:translate-x-1 transition-all">
              <ChevronRight class="w-3.5 h-3.5 text-blue-400" /> Olahraga
            </a>
          </li>
          <li>
            <a href="#berita-terbaru" class="flex items-center gap-1.5 hover:text-white hover:translate-x-1 transition-all">
              <ChevronRight class="w-3.5 h-3.5 text-blue-400" /> Berita
            </a>
          </li>
          <li>
            <a href="#galeri" class="flex items-center gap-1.5 hover:text-white hover:translate-x-1 transition-all">
              <ChevronRight class="w-3.5 h-3.5 text-blue-400" /> Galeri
            </a>
          </li>
          <li>
            <a href="#kontak" class="flex items-center gap-1.5 hover:text-white hover:translate-x-1 transition-all">
              <ChevronRight class="w-3.5 h-3.5 text-blue-400" /> Kontak
            </a>
          </li>
        </ul>
      </div>

      <!-- Col 4: Ikuti Kami & Map Silhouette (4 cols) -->
      <div class="lg:col-span-4 space-y-4">
        <div>
          <h4 class="text-sm font-bold text-white uppercase tracking-wider mb-3">
            Ikuti Kami
          </h4>
          <div class="flex items-center gap-2.5">
            <!-- Facebook -->
            <a 
              href={facebookUrl} 
              target="_blank" 
              rel="noopener noreferrer" 
              class="w-8 h-8 rounded-full bg-[#1877F2] text-white flex items-center justify-center hover:opacity-90 transition-opacity" 
              aria-label="Facebook"
            >
              <Facebook class="w-4 h-4" />
            </a>
            <!-- Instagram -->
            <a 
              href={instagramUrl} 
              target="_blank" 
              rel="noopener noreferrer" 
              class="w-8 h-8 rounded-full bg-gradient-to-tr from-[#FD1D1D] to-[#833AB4] text-white flex items-center justify-center hover:opacity-90 transition-opacity" 
              aria-label="Instagram"
            >
              <Instagram class="w-4 h-4" />
            </a>
            <!-- YouTube -->
            <a 
              href={youtubeUrl} 
              target="_blank" 
              rel="noopener noreferrer" 
              class="w-8 h-8 rounded-full bg-[#FF0000] text-white flex items-center justify-center hover:opacity-90 transition-opacity" 
              aria-label="YouTube"
            >
              <Youtube class="w-4 h-4" />
            </a>
            <!-- TikTok -->
            <a 
              href={tiktokUrl} 
              target="_blank" 
              rel="noopener noreferrer" 
              class="w-8 h-8 rounded-full bg-black border border-white/30 text-white flex items-center justify-center font-bold text-xs hover:opacity-90 transition-opacity" 
              aria-label="TikTok"
            >
              <span class="text-cyan-400 font-extrabold text-[11px]">d</span>
            </a>
          </div>

          <div class="mt-3 flex items-center gap-1.5 text-xs font-semibold text-white/90">
            <span>{hashtag}</span>
            <Leaf class="w-4 h-4 text-teal-400" />
          </div>
        </div>

        <!-- Smart Tourism Sukamara -->
        <div class="pt-2 border-t border-white/10">
          <div class="text-xs font-black tracking-wider uppercase text-white flex items-center gap-1.5">
            <span>SMART TOURISM</span>
            <span class="text-sky-400">SUKAMARA</span>
          </div>
          <p class="text-[11px] text-white/70 leading-relaxed mt-1">
            Portal promosi pariwisata dan layanan informasi terpadu Kabupaten Sukamara.
          </p>
        </div>

        <!-- Kalimantan Tengah map silhouette with Sukamara marker -->
        <div class="bg-white/5 rounded-xl p-3 border border-white/10 flex items-center justify-between">
          <div class="text-[11px] text-white/70">
            <div class="flex items-center gap-1.5 font-bold text-white">
              <span class="w-2 h-2 rounded-full bg-red-500 animate-pulse"></span>
              SUKAMARA
            </div>
            <div class="text-[10px] text-white/60">Kalimantan Tengah</div>
          </div>
          
          <svg viewBox="0 0 100 80" class="w-24 h-16 text-white/20 fill-current">
            <path d="M25,15 Q35,5 55,10 Q75,12 85,25 Q95,45 80,65 Q65,75 40,75 Q20,75 15,55 Q10,35 25,15 Z" />
            <!-- Pin location on lower west -->
            <circle cx="22" cy="58" r="4" class="fill-red-500 animate-ping" />
            <circle cx="22" cy="58" r="3" class="fill-red-500" />
          </svg>
        </div>

      </div>

    </div>

    <!-- Bottom copyright -->
    <div class="pt-6 flex flex-col sm:flex-row items-center justify-between text-xs text-white/60 gap-3">
      <p>{copyright}</p>
      <div class="flex items-center gap-4 text-white/60">
        <a href="#" class="hover:text-white transition-colors">Kebijakan Privasi</a>
        <span>|</span>
        <a href="#" class="hover:text-white transition-colors">Syarat Penggunaan</a>
        <span>|</span>
        <a href="#" class="hover:text-white transition-colors">Peta Situs</a>
      </div>
    </div>
  </div>
</footer>