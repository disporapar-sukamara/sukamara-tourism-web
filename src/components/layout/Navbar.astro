---
import { Menu, Search } from 'lucide-astro';

const navItems = [
  { label: 'Beranda', href: '#hero-carousel' },
  { label: 'Destinasi', href: '#destinasi-unggulan' },
  { label: 'Peta Wisata', href: '#peta-wisata' },
  { label: 'Event', href: '#agenda-mendatang' },
  { label: 'Pemuda & Olahraga', href: '#kepemudaan-olahraga' },
  { label: 'Berita', href: '#berita-terbaru' },
  { label: 'Galeri', href: '#galeri' },
  { label: 'Profil Dinas', href: '#profil-dinas' },
];
---

<header class="bg-white border-b border-gray-100 shadow-sm sticky top-0 z-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between items-center h-20">
      
      <!-- Left: 3 Logos -->
      <div class="flex items-center gap-3 sm:gap-4">
        <!-- Logo 1: Pemkab Sukamara -->
        <a href="#hero-carousel" class="flex items-center gap-2.5 group">
          <img 
            src="/images/branding/logo-kabupaten-sukamara.png" 
            alt="Lambang Kabupaten Sukamara" 
            width="34"
            height="44"
            class="h-11 w-auto object-contain"
          />
          <div class="flex flex-col">
            <span class="text-[9px] sm:text-[10px] font-bold tracking-wider text-gray-500 uppercase leading-none">
              Pemerintah Kabupaten
            </span>
            <span class="text-base sm:text-lg font-black tracking-wider text-[#0B2A5B] leading-tight">
              SUKAMARA
            </span>
          </div>
        </a>

        <!-- Divider line -->
        <div class="h-8 w-px bg-gray-200 hidden sm:block"></div>

        <!-- Logo 2: Disporapar stylized branding -->
        <div class="hidden sm:flex items-center gap-1.5">
          <div class="flex flex-col">
            <span class="text-base sm:text-lg font-black leading-none tracking-tight">
              <span class="text-[#1E5FD8]">dis</span><span class="text-[#B81267]">pora</span><span class="text-[#0F766E]">par</span>
            </span>
            <span class="text-[8px] font-bold text-gray-600 tracking-wider text-right -mt-0.5">
              Kab. Sukamara
            </span>
          </div>
        </div>

        <!-- Logo 3: Sukamara Janga Circular Badge -->
        <div class="hidden md:flex items-center">
          <div class="w-10 h-10 rounded-full p-0.5 bg-gradient-to-tr from-[#1E5FD8] via-[#0E9F8E] to-[#D6197A] flex items-center justify-center shadow-sm">
            <div class="w-full h-full rounded-full bg-white flex flex-col items-center justify-center p-0.5 text-center">
              <span class="text-[7px] font-black leading-none text-[#0B2A5B]">SUKAMARA</span>
              <span class="text-[6px] font-bold text-[#D6197A] leading-none">JANGA</span>
            </div>
          </div>
        </div>

        <!-- Logo 4: Smart Tourism Sukamara -->
        <div class="hidden md:flex items-center" title="Smart Tourism Sukamara">
          <picture>
            <source srcset="/images/branding/logo-smart-tourism-sukamara.webp" type="image/webp" />
            <img 
              src="/images/branding/logo-smart-tourism-sukamara.png" 
              alt="Logo Smart Tourism Sukamara" 
              width="40"
              height="40"
              loading="eager"
              decoding="async"
              class="w-10 h-10 object-contain rounded-full shadow-sm"
            />
          </picture>
        </div>
      </div>

      <!-- Right: Desktop Navigation -->
      <nav class="hidden lg:flex items-center space-x-5 xl:space-x-6" aria-label="Menu Utama">
        {navItems.map((item, idx) => (
          <div class="nav-item relative py-2">
            <a 
              href={item.href}
              data-target={item.href.replace('#', '')}
              class={`nav-link flex items-center gap-1 text-sm font-semibold transition-colors duration-200 ${
                idx === 0 
                  ? 'text-[#1E5FD8] font-bold' 
                  : 'text-gray-700 hover:text-[#1E5FD8]'
              }`}
            >
              {item.label}
            </a>
            <span class={`nav-indicator absolute bottom-0 left-0 w-full h-[2.5px] bg-[#1E5FD8] rounded-full transition-all duration-200 ${idx === 0 ? 'opacity-100' : 'opacity-0'}`}></span>
          </div>
        ))}
      </nav>

      <!-- Header Actions: Search trigger & Mobile menu button -->
      <div class="flex items-center gap-1 sm:gap-2">
        <button 
          type="button" 
          id="navbar-search-btn"
          class="p-2 rounded-xl text-gray-600 hover:text-[#1E5FD8] hover:bg-blue-50 transition-colors focus:outline-none cursor-pointer flex items-center gap-1.5"
          aria-label="Cari di website"
        >
          <Search class="w-5 h-5" />
          <span class="hidden md:inline text-xs font-semibold text-gray-500 hover:text-[#1E5FD8]">Cari</span>
        </button>

        <!-- Mobile menu button -->
        <div class="lg:hidden flex items-center">
          <button 
            type="button" 
            id="mobile-menu-btn"
            class="p-2 rounded-lg text-gray-700 hover:text-[#1E5FD8] hover:bg-gray-100 focus:outline-none"
            aria-label="Buka Menu"
          >
            <Menu class="w-6 h-6" />
          </button>
        </div>
      </div>

    </div>
  </div>

  <!-- Mobile menu drawer -->
  <div id="mobile-menu" class="hidden lg:hidden border-t border-gray-100 bg-white px-4 pt-2 pb-4 space-y-1">
    {navItems.map((item, idx) => (
      <a 
        href={item.href}
        data-target={item.href.replace('#', '')}
        class={`mobile-nav-link block py-2.5 px-3 rounded-md text-sm font-semibold transition-colors ${
          idx === 0 ? 'bg-blue-50 text-[#1E5FD8] font-bold' : 'text-gray-700 hover:bg-gray-50'
        }`}
      >
        {item.label}
      </a>
    ))}
  </div>
</header>

<script>
  // ponytail: Simple scrollspy with scroll listener; handles fast scrolling and instant click feedback without heavy router plugins
  function initScrollSpy() {
    const navLinks = document.querySelectorAll<HTMLAnchorElement>('.nav-link');
    const navIndicators = document.querySelectorAll<HTMLElement>('.nav-indicator');
    const mobileLinks = document.querySelectorAll<HTMLAnchorElement>('.mobile-nav-link');
    const mobileMenu = document.getElementById('mobile-menu');
    const mobileMenuBtn = document.getElementById('mobile-menu-btn');

    mobileMenuBtn?.addEventListener('click', () => {
      mobileMenu?.classList.toggle('hidden');
    });

    const sectionTargets: { id: string; el: HTMLElement }[] = [];
    navLinks.forEach((link) => {
      const targetId = link.getAttribute('data-target');
      if (targetId) {
        const el = document.getElementById(targetId);
        if (el) {
          sectionTargets.push({ id: targetId, el });
        }
      }
    });

    function setActive(activeId: string) {
      navLinks.forEach((link, idx) => {
        const targetId = link.getAttribute('data-target');
        const isActive = targetId === activeId;
        const indicator = navIndicators[idx];

        if (isActive) {
          link.classList.add('text-[#1E5FD8]', 'font-bold');
          link.classList.remove('text-gray-700');
          if (indicator) {
            indicator.classList.remove('opacity-0');
            indicator.classList.add('opacity-100');
          }
        } else {
          link.classList.remove('text-[#1E5FD8]', 'font-bold');
          link.classList.add('text-gray-700');
          if (indicator) {
            indicator.classList.remove('opacity-100');
            indicator.classList.add('opacity-0');
          }
        }
      });

      mobileLinks.forEach((link) => {
        const targetId = link.getAttribute('data-target');
        const isActive = targetId === activeId;
        if (isActive) {
          link.classList.add('bg-blue-50', 'text-[#1E5FD8]', 'font-bold');
          link.classList.remove('text-gray-700');
        } else {
          link.classList.remove('bg-blue-50', 'text-[#1E5FD8]', 'font-bold');
          link.classList.add('text-gray-700');
        }
      });
    }

    let isManualClick = false;
    let manualTimeout: number | undefined;

    function setupClick(link: HTMLAnchorElement) {
      link.addEventListener('click', () => {
        const targetId = link.getAttribute('data-target');
        if (!targetId) return;

        setActive(targetId);
        isManualClick = true;
        clearTimeout(manualTimeout);
        manualTimeout = window.setTimeout(() => {
          isManualClick = false;
        }, 900);

        if (mobileMenu && !mobileMenu.classList.contains('hidden')) {
          mobileMenu.classList.add('hidden');
        }
      });
    }

    navLinks.forEach(setupClick);
    mobileLinks.forEach(setupClick);

    function onScroll() {
      if (isManualClick || !sectionTargets.length) return;
      const scrollPos = window.scrollY + 100;

      if (window.scrollY < 180) {
        setActive(sectionTargets[0].id);
        return;
      }

      let currentActiveId = sectionTargets[0].id;
      for (const { id, el } of sectionTargets) {
        if (scrollPos >= el.offsetTop) {
          currentActiveId = id;
        }
      }

      if (currentActiveId) {
        setActive(currentActiveId);
      }
    }

    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();

    // Hook search button to modal
    const searchBtn = document.getElementById('navbar-search-btn');
    searchBtn?.addEventListener('click', () => {
      (window as any).openSearchModal?.('');
    });
  }

  initScrollSpy();
  document.addEventListener('astro:after-swap', initScrollSpy);
</script>