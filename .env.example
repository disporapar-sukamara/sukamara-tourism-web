# Basic Auth untuk /admin
ADMIN_USER=admin
ADMIN_PASSWORD=adminsukamara

# Keystatic GitHub Storage Mode (Wajib diisi di Cloudflare / Production)
# Dapatkan melalui wizard setup Keystatic atau buat GitHub OAuth / GitHub App:
KEYSTATIC_SECRET=generate_random_string_minimal_32_karakter_disini
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=
